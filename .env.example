# --- database ---
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=arogyamed

# --- security (JWT_SECRET and APP_OTP_SECRET need 32+ characters) ---
JWT_SECRET=change-me-to-a-long-random-string-32chars-min
APP_OTP_SECRET=change-me-another-long-random-string-32chars

# --- email (Gmail needs an App Password, not your normal password) ---
APP_MAIL_FROM=your-address@gmail.com
SPRING_MAIL_USERNAME=your-address@gmail.com
SPRING_MAIL_PASSWORD=your-gmail-app-password

# --- first admin account, created on first start if it does not exist ---
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=change-me-admin-password

# --- browser addresses allowed to call the API ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173